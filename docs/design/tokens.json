{
  "meta": {
    "name": "sky",
    "version": "1.0.0",
    "inspiredBy": "strava-structure",
    "primarySource": "sky-bot-blue",
    "colorScheme": "light",
    "description": "Outdoor sport data app. Strava-like structure with Sky bot blue. Human-readable spec: docs/design/sky-design-system.md"
  },
  "color": {
    "primary": "#1E88FE",
    "primaryPressed": "#1C7DEA",
    "background": "#FFFFFF",
    "grouped": "#F5F5F7",
    "card": "#FFFFFF",
    "cardBorder": "#E4F1FF",
    "recordCard": "#E6F1FE",
    "ink": "#1C1C1E",
    "secondary": "#8E8E93",
    "nickname": "#636366",
    "tertiary": "#C6C6C8",
    "separator": "#C6C6C8",
    "success": "#34C759",
    "warning": "#FF9500",
    "danger": "#FF3B30",
    "onPrimary": "#FFFFFF",
    "chartTrack": "#1E88FE",
    "chartNeutral": "#8E8E93",
    "chartNeutralMuted": "#C6C6C8",
    "metric": {
      "duration": "#A16207",
      "distance": "#0277BD",
      "pace": "#0B7F7A",
      "heartRate": "#D13924",
      "elevation": "#15803D",
      "energy": "#C2183B",
      "load": "#6D28D9",
      "score": "#1E88FE"
    },
    "zone": {
      "base": "#1E88FE",
      "endurance": "#15803D",
      "threshold": "#A16207",
      "speed": "#C2410C",
      "sprint": "#D13924"
    }
  },
  "typography": {
    "fontFamily": "SF Pro",
    "dynamicType": true,
    "largeTitle": { "size": 34, "weight": "bold" },
    "title": { "size": 28, "weight": "bold" },
    "title2": { "size": 22, "weight": "bold" },
    "title3": { "size": 20, "weight": "semibold" },
    "headline": { "size": 17, "weight": "semibold" },
    "body": { "size": 17, "weight": "regular" },
    "callout": { "size": 16, "weight": "regular" },
    "subheadline": { "size": 15, "weight": "regular" },
    "footnote": { "size": 13, "weight": "regular" },
    "caption": { "size": 12, "weight": "regular" },
    "metric": {
      "valueWeight": "bold",
      "unitMatchesValue": true,
      "labelStyle": "caption",
      "labelColor": "secondary",
      "unitStyle": "footnote",
      "unitColor": "secondary"
    }
  },
  "spacing": {
    "scale": [4, 8, 12, 16, 24, 32],
    "screenInset": 16,
    "cardPadding": 16,
    "related": 8,
    "section": 24,
    "listRowMin": 52,
    "listRowMax": 64,
    "touchMin": 44,
    "controlGap": 8
  },
  "radius": {
    "chip": 12,
    "card": 16,
    "sheet": 24,
    "button": "capsule"
  },
  "shadow": {
    "card": {
      "color": "#000000",
      "opacity": 0.1,
      "y": 6,
      "radius": 14
    }
  },
  "deprecated": {
    "note": "Keep these Swift palettes until pages migrate. Do not use them in new UI.",
    "names": [
      "SkyHomeColor",
      "omniCanvas",
      "omniIce",
      "omniCobalt",
      "omniDeep",
      "omniInk",
      "omniCoral",
      "omniMuted",
      "omniIdle",
      "LoginColor",
      "LoginWash",
      "LoginSkyBackground",
      "CanvasBackground"
    ]
  }
}
