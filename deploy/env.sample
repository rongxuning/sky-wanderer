# Vercel project environment. Do not commit a filled copy.
# Same-machine Docker (/opt/sky-wanderer) is paused; this file no longer feeds compose.
# See docs/deploy-sky.md and docs/architecture-backend.md.

PORT=8787
SKY_API_HOST=api.sky-wanderer.online

# Neon pooled connection string. The API uses this for queries.
DATABASE_URL=postgres://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon direct connection. Migrations prefer this so DDL does not go through the pooler.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

AUTH_DEMO=0
AUTH_CODE_PEPPER=
SESSION_TTL_DAYS=30

SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=https://api.sky-wanderer.online/v1/auth/google/callback
