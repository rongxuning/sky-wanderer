# Copy to deploy/.env and fill in. Do not commit the copy.
# Postgres password is also embedded in DATABASE_URL by docker-compose.prod.yml.
# Use a URL-safe password (letters and digits).

SKY_API_HOST=api.sky-wanderer.online
SKY_BIND_PORT=8788
POSTGRES_PASSWORD=replace-me
AUTH_DEMO=0
AUTH_CODE_PEPPER=
SESSION_TTL_DAYS=30

# http or aliyun. Leave empty to refuse SMS until credentials exist.
SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# WeChat Open Platform website / mobile app. The client sends an authorization code; the server exchanges it.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Web OAuth client. Redirect URI must be https://api.sky-wanderer.online/v1/auth/google/callback
# GOOGLE_CLIENT_IDS is the allowed ID-token audience (comma-separated).
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=https://api.sky-wanderer.online/v1/auth/google/callback
