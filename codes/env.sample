# Local Go API. Copy to a shell or a gitignored .env. Do not commit secrets.
# Vercel uses the same names. See docs/architecture-backend.md.

PORT=8787
SKY_API_HOST=api.sky-wanderer.online

# Neon pooled URL (hostname contains -pooler). Required unless AUTH_DEMO=1.
DATABASE_URL=postgres://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct Neon URL for DDL. Used for migrations when set; otherwise migrations use DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# 1 accepts phone code SKY-LOCAL and, without an authorization code, a client openid / Google sub.
# Without DATABASE_URL, demo mode stores accounts in DATA_FILE.
AUTH_DEMO=1
AUTH_CODE_PEPPER=
SESSION_TTL_DAYS=30
DATA_FILE=data/auth-store.json

# http or aliyun. Empty refuses SMS outside demo mode (sms_not_configured).
SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Comma-separated ID-token audiences. Web client secret exchanges an authorization code.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=https://api.sky-wanderer.online/v1/auth/google/callback
