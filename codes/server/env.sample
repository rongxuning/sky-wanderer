# Local process sample. Production on the VPS uses deploy/env.sample and deploy/docker-compose.prod.yml.
# Do not commit a filled .env.

PORT=8787
SKY_API_HOST=api.sky-wanderer.online
# Required unless AUTH_DEMO=1. Compose sets this to the Sky Postgres service, not Timia's database.
DATABASE_URL=postgres://sky:replace-me@127.0.0.1:5432/sky
AUTH_DEMO=0
AUTH_CODE_PEPPER=
SESSION_TTL_DAYS=30

SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=https://api.sky-wanderer.online/v1/auth/google/callback
