<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSHealthShareUsageDescription</key>
	<string>sky-wanderer 读取心率、睡眠、步数，以及徒步和跑步锻炼，用来显示训练记录和训练估计。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>sky-wanderer 把徒步和跑步写入健康 App。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sky 用当前位置判断当地日出和日落，并在开始和进行运动时显示位置和路线。</string>
	<key>NSMotionUsageDescription</key>
	<string>sky-wanderer 用步数估算运动中的步频。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rongxuning.sky-wanderer.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>skywanderer</string>
			</array>
		</dict>
	</array>
	<key>SKY_API_BASE_URL</key>
	<string>$(SKY_API_BASE_URL)</string>
	<key>SKY_AUTH_DEMO</key>
	<string>$(SKY_AUTH_DEMO)</string>
	<key>SKY_WECHAT_APP_ID</key>
	<string>$(SKY_WECHAT_APP_ID)</string>
	<key>SKY_GOOGLE_CLIENT_ID</key>
	<string>$(SKY_GOOGLE_CLIENT_ID)</string>
	<key>SKY_WECHAT_REDIRECT_URI</key>
	<string>$(SKY_WECHAT_REDIRECT_URI)</string>
	<key>SKY_GOOGLE_REDIRECT_URI</key>
	<string>$(SKY_GOOGLE_REDIRECT_URI)</string>
</dict>
</plist>
